# ============================================================================
# AGENTIC PRESCRIPTION GENERATOR - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and adjust variables as needed for your environment.

# ----------------------------------------------------------------------------
# 1. NETWORK & SERVICE PORTS
# ----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
NODE_PORT=5000
STREAMLIT_PORT=8501

# Python API Gateway Base URL (used by Node.js reverse proxy and Web UI)
PYTHON_API_BASE=http://127.0.0.1:8080

# WebSocket Real-Time Transcription Endpoint URL
WS_STREAM_URL=ws://127.0.0.1:8080/ws/transcribe

# ----------------------------------------------------------------------------
# 2. RUNTIME & HARDWARE
# ----------------------------------------------------------------------------
# Compute device preference: 'auto', 'cuda', or 'cpu'
DEVICE=auto

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment profile: development, production, testing
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# 3. CLINICAL EXTRACTION PIPELINE
# ----------------------------------------------------------------------------
# Default LLM GGUF model file name (located in GPT4All cache)
DEFAULT_LLM_MODEL=Meta-Llama-3-8B-Instruct.Q4_0.gguf

# Default STT ASR engine key: whisper_ayush, whisper_base, whisper_large_turbo, canary_1b, parakeet_tdt, moonshine_base, mock
DEFAULT_STT_MODEL=whisper_ayush

# Pipeline execution mode: auto (deterministic + LLM fallback), fast (deterministic only), llm_agent (full multi-agent)
DEFAULT_PIPELINE_MODE=auto

# Temperature for LLM generation (0.0 recommended for deterministic medical extraction)
TEMPERATURE=0.0

# Maximum token count for extraction responses
MAX_TOKENS=300

# ----------------------------------------------------------------------------
# 4. STORAGE & DATABASE PATHS
# ----------------------------------------------------------------------------
# SQLite Application State Database
SQLITE_PATH=./rx_extractor_app/data/app_state.db

# Master Drug Formulary Folder
DRUG_DATABASE_DIR=./Drug_databse

# Output Reports Directory (CSV/XLSX export logs)
OUTPUT_DIR=./rx_extractor_app/data/outputs

# Audio Storage Directory
AUDIO_DIR=./rx_extractor_app/data/audio_files
